# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — ONE key covers both STT and TTS
DEEPGRAM_API_KEY=

# Google Gemini
GEMINI_API_KEY=
# Pinned (not a rolling alias) -- verified live >=15 RPM (2026-08-21), vs 5
# RPM for gemini-flash-latest's current resolution (gemini-3.7-flash). See
# agent/config.py and docs/DEV_JOURNAL.md's 2026-08-21 entry.
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# GitHub (ingestion only)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Retrieval tuning -- 0.55, tuned in Phase 3 Day 4 (docs/DEV_JOURNAL.md,
# 2026-08-21) against the full TEST_PLAN.md Suite A/B set via
# ingestion/tune_threshold.py. Phase 2's original 0.5 was set against a
# single out-of-scope probe (~0.46 sim); the fuller sweep found real
# out-of-scope similarity up to 0.61 for some queries, and no threshold
# eliminates 100% of false accepts without gutting real-question recall
# (0.65 kills the last false accept but drops Suite A from 9/13 to 7/13) --
# 0.55 is the chosen balance, not a perfect separation.
RETRIEVAL_THRESHOLD=0.55
RETRIEVAL_TOP_K=5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Identity
OWNER_NAME=

# Worker resource tuning -- how many idle job-runner processes AgentServer
# keeps warm (each loads its own copy of the embedding model). Defaults to 2
# in code if unset; raise this on real server hardware, keep it low on a
# laptop running the worker locally (see docs/DEPLOYMENT.md Sec4).
WORKER_NUM_IDLE_PROCESSES=2
