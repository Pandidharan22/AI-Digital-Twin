# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — ONE key covers both STT and TTS
DEEPGRAM_API_KEY=

# Google Gemini
GEMINI_API_KEY=
# Pinned (not a rolling alias) -- verified live >=15 RPM (2026-08-21), vs 5
# RPM for gemini-flash-latest's current resolution (gemini-3.7-flash). See
# agent/config.py and docs/DEV_JOURNAL.md's 2026-08-21 entry.
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# GitHub (ingestion only)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Retrieval tuning -- 0.5 verified against real corpus data in Phase 2
# (docs/DEV_JOURNAL.md): bge-small-en-v1.5 cosine similarity for genuinely
# out-of-scope queries observed up to ~0.46 against this corpus, so 0.35 let
# an out-of-scope "favourite pizza topping" query through. Subject to further
# tuning in Phase 3 against the full TEST_PLAN.md question set.
RETRIEVAL_THRESHOLD=0.5
RETRIEVAL_TOP_K=4
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Identity
OWNER_NAME=
